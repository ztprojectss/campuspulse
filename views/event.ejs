<%- include('partials/header') %>
<article class="container section event-detail">
  <a href="/events" class="link-back">← All events</a>
  <div class="detail-hero" style="background-image: url('<%= event.image_url || '/placeholder.svg' %>')"></div>
  <div class="detail-grid">
    <div>
      <span class="chip chip-<%= event.category.toLowerCase() %>"><%= event.category %></span>
      <h1><%= event.title %></h1>
      <p class="lead"><%= event.summary %></p>

      <% if (user) { %>
        <h2 class="h3">About this event</h2>
        <% event.description.split(/\n+/).forEach(p => { %><p><%= p %></p><% }) %>
      <% } else { %>
        <div class="locked">
          <div class="locked-fade">
            <p><%= event.description.slice(0, 90) %>…</p>
          </div>
          <div class="locked-box">
            <strong>🔒 Members see the full details</strong>
            <p class="muted">Log in or create a free account to read the full description and RSVP.</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/login?next=/events/<%= event.id %>">Log in</a>
              <a class="btn btn-light" href="/register">Sign up</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <aside class="card side-card">
      <div class="side-row"><span class="side-label">Date</span><span><%= fmtDate(event.starts_at) %></span></div>
      <div class="side-row"><span class="side-label">Time</span><span><%= fmtTime(event.starts_at) %></span></div>
      <div class="side-row"><span class="side-label">Where</span><span><%= event.location %></span></div>
      <div class="side-row"><span class="side-label">Going</span><span><%= event.rsvp_count %><%= event.capacity ? ` / ${event.capacity}` : '' %></span></div>
      <% if (event.capacity) { %>
        <div class="meter"><span style="width: <%= Math.min(100, Math.round(event.rsvp_count / event.capacity * 100)) %>%"></span></div>
      <% } %>
      <% if (isPast) { %>
        <p class="muted center">This event has ended.</p>
      <% } else if (user) { %>
        <form method="post" action="/events/<%= event.id %>/rsvp">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (going) { %>
            <button class="btn btn-light btn-block" type="submit">✓ You're going · Cancel RSVP</button>
          <% } else if (event.capacity && event.rsvp_count >= event.capacity) { %>
            <button class="btn btn-block" type="button" disabled>Event full</button>
          <% } else { %>
            <button class="btn btn-primary btn-block" type="submit">RSVP: I'm going</button>
          <% } %>
        </form>
      <% } else { %>
        <a class="btn btn-primary btn-block" href="/login?next=/events/<%= event.id %>">Log in to RSVP</a>
      <% } %>
      <% if (user && user.role === 'admin') { %>
        <a class="btn btn-ghost btn-block" href="/admin/events/<%= event.id %>/edit">Edit event</a>
      <% } %>
    </aside>
  </div>
</article>
<%- include('partials/footer') %>
