<%- include('partials/header') %>
<section class="container section">
  <div class="page-head">
    <h1><%= showPast ? 'Past events' : 'Upcoming events' %></h1>
    <p class="muted"><%= events.length %> event<%= events.length === 1 ? '' : 's' %> found</p>
  </div>
  <form class="filters" method="get" action="/events">
    <input type="search" name="q" value="<%= q %>" placeholder="Search events, places…" aria-label="Search">
    <select name="category" aria-label="Category">
      <option value="">All categories</option>
      <% categories.forEach(c => { %><option <%= c === category ? 'selected' : '' %>><%= c %></option><% }) %>
    </select>
    <% if (showPast) { %><input type="hidden" name="past" value="1"><% } %>
    <button class="btn btn-primary" type="submit">Filter</button>
  </form>
  <div class="tabs">
    <a href="/events" class="<%= !showPast ? 'active' : '' %>">Upcoming</a>
    <a href="/events?past=1" class="<%= showPast ? 'active' : '' %>">Past</a>
  </div>
  <% if (events.length) { %>
    <div class="grid">
      <% events.forEach(e => { %><%- include('partials/event-card', { e }) %><% }) %>
    </div>
  <% } else { %>
    <div class="empty">No events match your search. <a href="/events">Clear filters</a></div>
  <% } %>
</section>
<%- include('partials/footer') %>
